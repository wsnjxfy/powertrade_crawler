APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/powertrade.db
REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRY_TIMES=2
USER_AGENT=powertrade-crawler/0.1 contact:your-email@example.com
GRIDSTATUS_MIN_INTERVAL_SECONDS=1.1
ENTSOE_MIN_INTERVAL_SECONDS=0.25
ELECHECK_AREA_CODE=320000000000
ELECHECK_START_DATE=
ELECHECK_END_DATE=

# 可选：免费 LLM 池客户端配置路径。留空时读取当前用户目录下的
# .config/llm-router/client-free.env。真实 LLM_API_KEY 只能保存在项目外的该文件中。
LLM_ROUTER_CLIENT_ENV=
