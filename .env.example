APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/powertrade.db
REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRY_TIMES=2
USER_AGENT=powertrade-crawler/0.1 contact:your-email@example.com
GRIDSTATUS_API_KEY=replace-with-your-gridstatus-api-key
GRIDSTATUS_MIN_INTERVAL_SECONDS=1.1
# Optional Elecheck authorization token. Keep it until Elecheck returns HTTP 401.
ELECHECK_AUTHORIZATION=
ELECHECK_AREA_CODE=320000000000
ELECHECK_START_DATE=
ELECHECK_END_DATE=
